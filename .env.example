# Copy to .env (git-ignored) and fill in. Only the Telegram pair is needed to
# receive notifications; every other setting has a safe default (docs/SPEC.md).
DSB_TELEGRAM_TOKEN=
DSB_TELEGRAM_CHAT_ID=
DSB_DATABASE_PATH=dexsignal.db
DSB_INTERVAL_SECONDS=300
DSB_MIN_LIQUIDITY_USD=50000
DSB_MAX_VOLUME_TO_LIQUIDITY=50
DSB_RUGCHECK_MAX_SCORE=50
DSB_WINDOW_MINUTES=30
DSB_MIN_POINTS=3
DSB_RISE_PCT=100
DSB_FALL_PCT=50
DSB_LIQ_DROP_PCT=50
DSB_ALERT_COOLDOWN_MINUTES=360
DSB_RETENTION_DAYS=30
