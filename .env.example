# Copy to .env (git-ignored) and fill in. Only the Telegram pair is needed to
# receive notifications; every other setting has a safe default (docs/SPEC.md).
DSB_TELEGRAM_TOKEN=
DSB_TELEGRAM_CHAT_ID=
DSB_DATABASE_PATH=dexsignal.db
DSB_INTERVAL_SECONDS=300
DSB_MIN_LIQUIDITY_USD=50000
DSB_MAX_VOLUME_TO_LIQUIDITY=50
DSB_RUGCHECK_MAX_SCORE=50
DSB_WINDOW_MINUTES=30
DSB_MIN_POINTS=3
DSB_RISE_PCT=100
DSB_FALL_PCT=50
DSB_LIQ_DROP_PCT=50
DSB_ALERT_COOLDOWN_MINUTES=360
DSB_RETENTION_DAYS=30

# --- Risk intelligence (docs/SPEC.md FR-12 to FR-17) ---
# GoPlus works without a token today but may enforce one; set it if you have it.
DSB_GOPLUS_TOKEN=
DSB_GOPLUS_ENABLED=true
# Etherscan V2: deployer lookup for EVM tokens when GoPlus gives no creator.
DSB_ETHERSCAN_API_KEY=
# Pocket Universe: both required to enable. Method and parameter are not
# documented by the provider; confirm with `dexsignal probe pocket <mint>`.
DSB_POCKET_UNIVERSE_BASE_URL=
DSB_POCKET_UNIVERSE_API_KEY=
DSB_POCKET_UNIVERSE_METHOD=GET
DSB_POCKET_UNIVERSE_PARAM=address
DSB_STRICT_SCREENING=false
DSB_MAX_TAX_PCT=10
DSB_MAX_TOP10_PCT=50
DSB_DEPLOYER_MAX_RUGS=2
DSB_RUG_LIQ_DROP_PCT=80
DSB_TRACK_HOURS=24
DSB_LOG_FORMAT=text
